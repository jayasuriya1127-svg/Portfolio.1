<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
font-family:Arial,sans-serif;
}
body{
background:#0f172a;
color:white;
}
header{
position:fixed;
width:100%;
top:0;
background:#111827;
padding:20px 8%;
display:flex;
justify-content:space-between;
align-items:center;
z-index:1000;
}
.logo{
font-size:28px;
font-weight:bold;
color:#38bdf8;
}
nav a{
color:white;
