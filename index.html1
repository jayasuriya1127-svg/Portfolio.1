}
.hero{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}
.hero img{
width:180px;
height:180px;
border-radius:50%;
border:5px solid #38bdf8;
box-shadow:0 0 30px cyan;
