}
.btn{
display:inline-block;
margin-top:25px;
padding:15px 35px;
background:#38bdf8;
color:white;
border-radius:30px;
text-decoration:none;
font-weight:bold;
}
section{
padding:90px 8%;
}
h2{
text-align:center;
font-size:40px;
margin-bottom:40px;
color:#38bdf8;
}
.about{
max-width:900px;
margin:auto;
text-align:center;
line-height:1.8;
font-size:18px;
}
.skills{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
gap:20px;
}
.skill{
background:#1e293b;
padding:20px;
text-align:center;
border-radius:10px;
font-size:20px;
transition:.3s;
}
.skill:hover{
transform:scale(1.08);
background:#38bdf8;
}
.projects{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
gap:25px;
}
.card{
background:#1e293b;
padding:25px;
border-radius:15px;
transition:.3s;
}
.card:hover{
transform:translateY(-10px);
}
.contact{
text-align:center;
line-height:2;
font-size:20px;
}
footer{
background:#111827;
padding:20px;
text-align:center;
margin-top:40px;
}
</style>
</head>

